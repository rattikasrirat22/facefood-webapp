# ============================================================================
# FaceFood — Frontend environment
#
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#   cp .env.example .env.local
#
# หมายเหตุ: ตัวแปรต้องขึ้นต้นด้วย NEXT_PUBLIC_ เพราะเบราว์เซอร์เป็นคนยิง API เอง
#          ห้ามใส่ secret/API key ในไฟล์กลุ่มนี้ เพราะค่าจะถูกฝังลงไปใน JS bundle
# ============================================================================

# URL ของ Backend (ไม่ต้องมี / ปิดท้าย)
# ถ้าเว้นว่าง Frontend จะใช้ข้อมูลจำลองใน src/lib/mockData.ts อัตโนมัติ
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# บังคับใช้ข้อมูลจำลองแม้จะตั้ง API_BASE_URL แล้ว — ใช้ตอนเดโมหรือตอน Backend ยังไม่ขึ้น
NEXT_PUBLIC_USE_MOCK=false

# timeout ของการเรียก API (มิลลิวินาที) — default 90000 เผื่อ Cloud Run cold start
# (วัดจริงพบ request แรกหลัง instance idle นานช้าได้ถึง ~25s+ ก่อนรวม inference/Firebase)
NEXT_PUBLIC_API_TIMEOUT_MS=90000
